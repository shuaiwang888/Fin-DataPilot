# ===== LLM =====
# LLM provider: minimax | openai | anthropic | custom (OpenAI-compatible)
LLM_PROVIDER=minimax
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=MiniMax-M3
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# ===== iWencai / 问财 API (used by 4 skills) =====
IWENCAI_API_KEY=your-iwencai-api-key-here
# IWENCAI_SKILL_ID_OVERRIDES=financial-query=hithink-financial-query,news-search=news-search

# ===== AnySearch (bundled web + vertical search skill) =====
# Optional: API key for higher rate limits. Without it, anonymous
# access is used. Get a key at https://anysearch.com/console/api-keys
ANYSEARCH_API_KEY=
# Path to the unpacked anysearch-skill/ directory. Leave empty to use
# the bundled Skills/anysearch-skill/ that ships with this repo.
ANYSEARCH_SKILL_DIR=
# Subprocess timeout in seconds (default 30).
ANYSEARCH_TIMEOUT=30

# ===== Server =====
DATA_PILOT_HOST=0.0.0.0
DATA_PILOT_PORT=7860
DATA_PILOT_ENV=development
# Required in production. Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-before-production
# Administrator-only endpoints (Skill management and diagnostics). Do not put
# this value in VITE_* variables or any public frontend build.
ADMIN_API_KEY=
# Legacy alias for ADMIN_API_KEY. Prefer ADMIN_API_KEY for new deployments.
API_KEY=

# ===== CORS =====
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ===== Storage =====
# Set to a Turso URL to use libSQL in production; leave empty to use local SQLite
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
LOCAL_SQLITE_PATH=./data/findatapilot.db
# HF-only fallback when the persistent /data volume is unavailable. Data here
# is intentionally ephemeral; use HF persistent storage or Turso for history.
HF_EPHEMERAL_DATA_PATH=/tmp/findatapilot

# ===== Agent =====
AGENT_MAX_SKILL_CALLS=8
AGENT_MAX_PARALLEL_SKILLS=1
AGENT_ENABLE_REFLECTION=true
AGENT_RUN_TIMEOUT_SECONDS=180

# Disabled by default. Prompt-only uploads require this AND ADMIN_API_KEY.
# Python code uploads are always rejected in the API process.
ENABLE_SKILL_UPLOAD=false

# ===== Observability =====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LOG_LEVEL=INFO
